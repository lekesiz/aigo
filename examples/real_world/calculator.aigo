module main

import std.io

// Basic calculator functions
fn add(a: f64, b: f64) -> f64 {
    return a + b
}

fn subtract(a: f64, b: f64) -> f64 {
    return a - b
}

fn multiply(a: f64, b: f64) -> f64 {
    return a * b
}

fn divide(a: f64, b: f64) -> Result<f64, Error> {
    if b == 0.0 {
        return Err(Error::new("Division by zero"))
    }
    return Ok(a / b)
}

fn power(base: f64, exp: i32) -> f64 {
    let result: f64 = 1.0
    let i: i32 = 0

    if exp >= 0 {
        while i < exp {
            result = result * base
            i = i + 1
        }
    } else {
        let positive_exp: i32 = -exp
        while i < positive_exp {
            result = result * base
            i = i + 1
        }
        result = 1.0 / result
    }

    return result
}

fn square_root(n: f64) -> f64 {
    if n < 0.0 {
        return -1.0  // Error for negative numbers
    }

    if n == 0.0 || n == 1.0 {
        return n
    }

    // Newton's method
    let x: f64 = n
    let epsilon: f64 = 0.00001
    let max_iterations: i32 = 100
    let iterations: i32 = 0

    while iterations < max_iterations {
        let next_x: f64 = (x + n / x) / 2.0
        let diff: f64 = x - next_x

        if diff < 0.0 {
            diff = -diff
        }

        if diff < epsilon {
            return next_x
        }

        x = next_x
        iterations = iterations + 1
    }

    return x
}

fn factorial(n: i32) -> i32 {
    if n < 0 {
        return -1  // Error for negative numbers
    }

    let result: i32 = 1
    let i: i32 = 1

    while i <= n {
        result = result * i
        i = i + 1
    }

    return result
}

fn percentage(value: f64, percent: f64) -> f64 {
    return (value * percent) / 100.0
}

fn main() -> Result<void, Error> {
    io.println("=== AIGo Calculator ===")?

    // Basic arithmetic
    io.println("\n--- Basic Arithmetic ---")?
    io.println("10 + 5 =", add(10.0, 5.0))?
    io.println("10 - 5 =", subtract(10.0, 5.0))?
    io.println("10 * 5 =", multiply(10.0, 5.0))?

    let div_result = divide(10.0, 5.0)?
    io.println("10 / 5 =", div_result)?

    // Power
    io.println("\n--- Power ---")?
    io.println("2^3 =", power(2.0, 3))?
    io.println("5^2 =", power(5.0, 2))?
    io.println("2^-2 =", power(2.0, -2))?

    // Square root
    io.println("\n--- Square Root ---")?
    io.println("√16 =", square_root(16.0))?
    io.println("√25 =", square_root(25.0))?
    io.println("√2 ≈", square_root(2.0))?

    // Factorial
    io.println("\n--- Factorial ---")?
    io.println("5! =", factorial(5))?
    io.println("7! =", factorial(7))?
    io.println("10! =", factorial(10))?

    // Percentage
    io.println("\n--- Percentage ---")?
    io.println("20% of 100 =", percentage(100.0, 20.0))?
    io.println("15% of 250 =", percentage(250.0, 15.0))?

    // Compound calculations
    io.println("\n--- Compound Calculations ---")?

    // Area of circle: π * r^2
    let pi: f64 = 3.14159
    let radius: f64 = 5.0
    let area: f64 = multiply(pi, power(radius, 2))
    io.println("Area of circle (r=5):", area)?

    // Pythagorean theorem: c = √(a² + b²)
    let a: f64 = 3.0
    let b: f64 = 4.0
    let c: f64 = square_root(add(power(a, 2), power(b, 2)))
    io.println("Hypotenuse (a=3, b=4):", c)?

    // Compound interest: A = P(1 + r/n)^(nt)
    let principal: f64 = 1000.0
    let rate: f64 = 0.05  // 5%
    let time: i32 = 2     // 2 years
    let amount: f64 = multiply(principal, power(add(1.0, rate), time))
    io.println("Compound interest (P=1000, r=5%, t=2):", amount)?

    return Ok(void)
}
